<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <Nullable>enable</Nullable>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <!-- exe 图标: 文件资源管理器、任务栏固定(pin)时显示。 -->
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <ItemGroup>
    <!-- 多分辨率图标嵌入程序集, 运行时用于窗体(标题栏/任务栏/Alt-Tab)与托盘。 -->
    <EmbeddedResource Include="app.ico" />
  </ItemGroup>

  <ItemGroup>
    <!-- 固定在 8.0.6: 8.0.9 起 ExplorerBrowser 的 ICommDlgBrowser3.IncludeObject
         会调用 FireContentChanged() -> UpdateSearchState() -> Items, 而 Items
         getter 每次都会重建整个项目集合。IncludeObject 每个条目调用一次, 于是
         大目录(如 C:\Windows\System32)变成 O(N^2), 界面假死。
         8.0.15 起还改了 PreFilterMessage 的焦点判断, 导致 Ctrl+C/Ctrl+V 复制粘贴失效。
         8.0.6 无以上两个问题。升级前请务必验证: 复制粘贴、大目录导航不卡死。 -->
    <PackageReference Include="WindowsAPICodePack" Version="8.0.6" />
  </ItemGroup>

</Project>